# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=smps_user
POSTGRES_PASSWORD=smps_pass
POSTGRES_DB=smpsdb

# ── JWT ───────────────────────────────────────────────────────────────────────
# SecretKey must be at least 32 characters
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ISSUER=SMPS.API
JWT_AUDIENCE=SMPS.Client
JWT_EXPIRY_MINUTES=60
